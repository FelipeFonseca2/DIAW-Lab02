@startuml casos-de-uso
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

title Sistema de Aluguel de Carros - Diagrama de Casos de Uso

actor "Usuário" as Usuario
actor "Cliente" as Cliente
actor "Agente" as Agente
actor "Empresa" as Empresa
actor "Banco" as Banco

Cliente -|> Usuario
Agente -|> Usuario
Empresa -|> Agente
Banco -|> Agente

rectangle "Sistema de Aluguel de Carros" {
  usecase "UC01 - Realizar login" as UC01
  usecase "UC02 - Cadastrar-se" as UC02
  usecase "UC03 - Manter próprio cadastro\n(consultar, atualizar, excluir)" as UC03
  usecase "UC04 - Introduzir pedido de aluguel" as UC04
  usecase "UC05 - Consultar pedidos e status" as UC05
  usecase "UC06 - Modificar pedido" as UC06
  usecase "UC07 - Cancelar pedido" as UC07
  usecase "UC08 - Avaliar pedido\n(análise financeira)" as UC08
  usecase "UC09 - Executar contrato" as UC09
  usecase "UC10 - Conceder contrato de crédito" as UC10
  usecase "UC11 - Consultar clientes" as UC11
}

Usuario --> UC01
Usuario --> UC05
Usuario --> UC06

Cliente --> UC02
Cliente --> UC03
Cliente --> UC04
Cliente --> UC07

Agente --> UC08
Agente --> UC09
Agente --> UC11

Banco --> UC10
UC10 .> UC09 : <<extend>>

@enduml
